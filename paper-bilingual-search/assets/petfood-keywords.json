  "presets": [
    {
      "id": "P1",
      "theme": "功能性成分与肠道健康",
      "query": "(犬 OR 猫 OR 伴侣动物) AND (益生菌 OR 益生元 OR 透明质酸 OR 丝兰提取物) AND 肠道健康"
    },
    {
      "id": "P2",
      "theme": "天然植物与毛发改善",
      "query": "(犬 OR 猫 OR 伴侣动物) AND (多不饱和脂肪酸 OR 水解角蛋白 OR 蛋黄卵磷脂) AND (毛发 OR 皮肤)"
    },
    {
      "id": "P3",
      "theme": "中药材与免疫调节",
      "query": "(犬 OR 猫 OR 伴侣动物) AND (黄芪 OR 枸杞 OR 人参 OR 甘草) AND (免疫 OR 抗氧化)"
    },
    {
      "id": "P4",
      "theme": "加工工艺与营养保留",
      "query": "(冻干 OR 烘焙 OR 膨化) AND 宠物食品 AND (营养保留 OR 消化率 OR 适口性)"
    },
    {
      "id": "P5",
      "theme": "关节健康功能食品",
      "query": "(犬 OR 猫 OR 伴侣动物) AND (透明质酸 OR 氨糖 OR 软骨素) AND (关节 OR 骨关节炎)"
    },
    {
      "id": "P6",
      "theme": "心血管营养干预",
      "query": "(犬 OR 猫 OR 伴侣动物) AND (牛磺酸 OR Omega-3 OR 辅酶 Q10) AND (心脏 OR 心血管)"
    },
    {
      "id": "P7",
      "theme": "低敏水解宠物食品研究",
      "query": "(犬 OR 猫 OR 伴侣动物) AND (水解蛋白 OR 低敏 OR 食物过敏) AND (消化 OR 皮肤)"
    },
    {
      "id": "P8",
      "theme": "老龄犬猫营养干预",
      "query": "(犬 OR 猫 OR 伴侣动物) AND (老龄 OR 老年) AND (抗氧化 OR 关节 OR 认知)"
    },
