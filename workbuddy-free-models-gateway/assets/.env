# HTTP listener
PROXY_HOST=127.0.0.1
PROXY_PORT=3000
PROXY_API_KEY=local

# WorkBuddy installation.
# Leave WORKBUDDY_EXE empty to auto-discover from
#   %LOCALAPPDATA%\Programs\WorkBuddy\WorkBuddy.exe   (standard C: install)
# If WorkBuddy is on another drive while LOCALAPPDATA points to C: (common on
# campus / managed machines), set the absolute path here, e.g.:
#   WORKBUDDY_EXE=D:\Users\<your-user>\AppData\Local\Programs\WorkBuddy\WorkBuddy.exe
# The bundled start_bridge.bat also auto-detects the D: location, so you usually
# do NOT need to edit this.
WORKBUDDY_EXE=
WORKBUDDY_CLI_SCRIPT=
# WORKBUDDY_CWD=C:\Users\<user>\WorkBuddy

# Models
WORKBUDDY_DEFAULT_MODEL=auto
WORKBUDDY_MODELS=
WORKBUDDY_MODEL_ALIASES={"wb-auto":"auto","wb-glm-5.3":"glm-5.3","wb-glm-5.3-flash":"glm-5.3-flash","wb-kimi-k3-1":"kimi-k3-1","wb-deepseek-v4-pro":"deepseek-v4-pro","wb-deepseek-v4-flash":"deepseek-v4-flash","wb-minimax-m3":"minimax-m3","wb-hy3":"hy3"}
WORKBUDDY_PRODUCT_CONFIG=

# Runtime
WORKBUDDY_MAX_TURNS=8
WORKBUDDY_REQUEST_TIMEOUT_MS=300000
WORKBUDDY_START_TIMEOUT_MS=45000
WORKBUDDY_SYSTEM_PROMPT=You are serving an API chat request. Answer the user directly. Use WorkBuddy built-in tools and configured MCP tools when they help complete the request.

# WorkBuddy account dashboard
WORKBUDDY_ACCOUNT_SESSION_PATH=
WORKBUDDY_ACCOUNT_TIMEOUT_MS=15000
WORKBUDDY_USAGE_LEDGER_MAX_RECORDS=1000

# WorkBuddy tools and MCP
WORKBUDDY_DISABLE_TOOLS=0
WORKBUDDY_TOOLS=default
WORKBUDDY_ALLOWED_TOOLS=
WORKBUDDY_DISALLOWED_TOOLS=
WORKBUDDY_ADD_DIRS=
WORKBUDDY_PERMISSION_MODE=bypassPermissions
WORKBUDDY_MCP_CONFIG=
WORKBUDDY_STRICT_MCP_CONFIG=0
WORKBUDDY_MCP_REFRESH_MS=15000
WORKBUDDY_MCP_ADMIN_TIMEOUT_MS=12000
WORKBUDDY_MCP_ADMIN_CACHE_MS=30000
WORKBUDDY_EVENT_MAX_BYTES=65536
